{
  "openapi": "3.0.0",
  "info": {
    "title": "API Gateway Documentation",
    "description": "Documentation for the API Gateway endpoints",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API Gateway"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Returns the health status of the API",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
} 