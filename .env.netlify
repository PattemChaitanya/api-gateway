# Server Configuration
PORT=9080
NODE_ENV=production

# MongoDB Configuration
MONGODB_URL=mongodb+srv://dummy-user:dummy-password@cluster0.example.mongodb.net
DB_NAME=api_gateway_prod

# Redis Configuration
REDIS_HOST=redis-12345.c123.us-east-1-1.ec2.cloud.redislabs.com
REDIS_PORT=12345
REDIS_PASSWORD=dummy-redis-password

# Service Configuration
FIRST_SERVICE_SECRET=dummy-first-service-secret-key-123
SECOND_SERVICE_SECRET=dummy-second-service-secret-key-456
GATEWAY_SECRET_KEY=dummy-gateway-secret-key-789

# Authentication
JWT_SECRET=dummy-jwt-super-secret-key-abc-123
SALT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
MAX_REQUESTS_PER_WINDOW=100
RATE_LIMIT_WHITELIST=127.0.0.1,localhost

# Monitoring
LOG_LEVEL=info
METRICS_INTERVAL=300000

# Netlify Specific
NETLIFY_SITE_ID=dummy-site-id
NETLIFY_AUTH_TOKEN=dummy-auth-token

# API Keys (if needed)
API_KEY_1=dummy-api-key-1
API_KEY_2=dummy-api-key-2

# Cache Configuration
CACHE_TTL=3600
CACHE_PREFIX=api_gateway

# Cors Configuration
ALLOWED_ORIGINS=https://example.com,https://api.example.com 