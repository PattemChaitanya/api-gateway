# Server Configuration
PORT=8888
NODE_ENV=production

# Firebase Configuration
FIREBASE_API_KEY=${FIREBASE_API_KEY}
FIREBASE_AUTH_DOMAIN=${FIREBASE_AUTH_DOMAIN}
FIREBASE_PROJECT_ID=${FIREBASE_PROJECT_ID}
FIREBASE_STORAGE_BUCKET=${FIREBASE_STORAGE_BUCKET}
FIREBASE_MESSAGING_SENDER_ID=${FIREBASE_MESSAGING_SENDER_ID}
FIREBASE_APP_ID=${FIREBASE_APP_ID}
FIREBASE_MEASUREMENT_ID=${FIREBASE_MEASUREMENT_ID}

# Redis Configuration
REDIS_URL=${REDIS_URL}

# JWT Configuration
JWT_SECRET=${JWT_SECRET}

# Security
SALT_ROUNDS=12

# Logging
LOG_LEVEL=info

# Service Configuration
FIRST_SERVICE_SECRET=dummy-first-service-secret-key-123
SECOND_SERVICE_SECRET=dummy-second-service-secret-key-456
GATEWAY_SECRET_KEY=dummy-gateway-secret-key-789

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
MAX_REQUESTS_PER_WINDOW=100
RATE_LIMIT_WHITELIST=127.0.0.1,localhost

# Monitoring
METRICS_INTERVAL=300000

# Netlify Specific
NETLIFY_SITE_ID=dummy-site-id
NETLIFY_AUTH_TOKEN=dummy-auth-token

# API Keys (if needed)
API_KEY_1=dummy-api-key-1
API_KEY_2=dummy-api-key-2

# Cache Configuration
CACHE_TTL=3600
CACHE_PREFIX=api_gateway

# Cors Configuration
ALLOWED_ORIGINS=https://example.com,https://api.example.com 