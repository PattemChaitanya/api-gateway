# Server Configuration
PORT=9080
NODE_ENV=development

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DB_NAME=api_gateway_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=9090
REDIS_PASSWORD=

# Service Secret Keys
FIRST_SERVICE_SECRET=your_first_service_secret
SECOND_SERVICE_SECRET=your_second_service_secret
GATEWAY_SECRET_KEY=your_gateway_secret

# Authentication
JWT_SECRET=your_jwt_secret_key
SALT_ROUNDS=10

# Service URLs
FIRST_SERVICE_URL=http://localhost:9080
SECOND_SERVICE_URL=http://localhost:9081 